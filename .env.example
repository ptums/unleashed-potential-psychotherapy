# Content source: "mock" (default, handoff content in content/mock) or "cms".
CONTENT_SOURCE=mock
# CMS public API base URL. Needed only when CONTENT_SOURCE=cms. Set it in .env.local and as a GitHub Actions variable.
CMS_API_URL=
# Public site origin for the sitemap and robots. Defaults to https://uptherapygroup.com.
SITE_URL=
