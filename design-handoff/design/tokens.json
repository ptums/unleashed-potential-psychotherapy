{
  "color": {
    "forestDark": { "value": "#31464B", "use": "text, headings, button borders, dark band background" },
    "forest": { "value": "#506967", "use": "secondary text on linen or light cream only; hairlines" },
    "error": { "value": "#9B2C2C", "use": "error text, invalid field border" },
    "linen": { "value": "#FAF7F2", "use": "page background; text on dark bands" },
    "creamLight": { "value": "#EEE8D4", "use": "background and decoration only" },
    "cream": { "value": "#D9CEB5", "use": "background and decoration only" },
    "creamDark": { "value": "#C7B79F", "use": "background and decoration only" }
  },
  "contrast": {
    "forestDark/linen": 9.32,
    "forestDark/creamLight": 8.12,
    "forestDark/cream": 6.38,
    "forest/linen": 5.52,
    "forest/creamLight": 4.81,
    "linen/forestDark": 9.32,
    "linen/forest": 5.52,
    "rule": "Text needs ≥4.5:1 (≥3:1 at 24px+ or 18.66px bold); UI borders ≥3:1. forest on cream (3.78) fails for body text."
  },
  "font": {
    "display": { "family": "Playfair Display", "weights": [500, 700], "italic": [500], "use": "headings, quotes, numerals" },
    "body": { "family": "Lato", "weights": [400, 700], "italic": [400], "use": "body, labels, buttons" }
  },
  "size": {
    "body": "17px", "small": "16px", "label": "14px", "lead": "19px",
    "h1": "clamp(40px, 5vw, 68px)", "h2": "clamp(32px, 3.6vw, 48px)", "h3": "26px"
  },
  "layout": {
    "containerMax": "1200px", "gutter": { "desktop": "40px", "mobile": "20px" },
    "navBreakpoint": "900px", "sectionPad": "clamp(72px, 9vw, 128px)"
  },
  "controls": {
    "radius": "0", "buttonBorder": "1.5px", "mainTarget": "48px", "minTarget": "44px",
    "focusRing": "3px solid #31464B, offset 3px (linen on dark bands)"
  }
}
