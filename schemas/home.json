{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Home",
  "description": "Content for the Home page. Layout is fixed by the template; each top-level property is one zone. Header, footer and crisis line come from site settings.",
  "type": "object",
  "additionalProperties": false,
  "x-cms": {
    "kind": "singleton",
    "route": "/",
    "template": "HomePage",
    "zones": [
      "hero",
      "featuredIn",
      "specialties",
      "clinicians",
      "howItWorks",
      "approachBand",
      "meta"
    ]
  },
  "required": [
    "hero",
    "featuredIn",
    "specialties",
    "clinicians",
    "howItWorks",
    "approachBand",
    "seo"
  ],
  "properties": {
    "hero": {
      "type": "object",
      "title": "Hero",
      "additionalProperties": false,
      "x-cms": {
        "zone": "hero",
        "order": 1
      },
      "required": [
        "eyebrow",
        "heading",
        "body",
        "primaryCta",
        "image"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Small caps line above the heading. Keep it short so it wraps cleanly on mobile."
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 90,
          "description": "The page's only H1."
        },
        "body": {
          "type": "string",
          "maxLength": 420,
          "description": "Intro paragraph under the heading.",
          "x-ui": {
            "widget": "textarea",
            "rows": 4
          }
        },
        "primaryCta": {
          "$ref": "#/$defs/link",
          "description": "Outlined button. Must go to the clinicians list or a profile, never straight to booking.",
          "default": {
            "label": "Meet our clinicians",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "clinicians"
              }
            }
          }
        },
        "secondaryLink": {
          "$ref": "#/$defs/link",
          "default": {
            "label": "What to expect",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "what-to-expect"
              }
            }
          }
        },
        "trustLine": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": "Short facts joined with a middle dot, e.g. Free 15-minute consultation."
        },
        "image": {
          "$ref": "#/$defs/image",
          "description": "Portrait-format photo (4:5)."
        }
      }
    },
    "featuredIn": {
      "type": "object",
      "title": "Featured in strip",
      "additionalProperties": false,
      "x-cms": {
        "zone": "featuredIn",
        "order": 1
      },
      "required": [
        "hidden",
        "label",
        "appearances",
        "allLink"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Featured in"
        },
        "appearances": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/reference"
          },
          "x-ui": {
            "widget": "referenceList",
            "collection": "mediaAppearances",
            "sortable": true
          },
          "description": "Each shows its outlet name, linked to its main URL."
        },
        "allLink": {
          "$ref": "#/$defs/link",
          "default": {
            "label": "All podcasts & press",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "featured-in"
              }
            }
          }
        }
      }
    },
    "specialties": {
      "type": "object",
      "title": "Specialties grid",
      "additionalProperties": false,
      "x-cms": {
        "zone": "specialties",
        "order": 1
      },
      "required": [
        "hidden",
        "eyebrow",
        "heading",
        "items",
        "tileLinkLabel"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Specialties"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "default": "What we treat"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "description": "1 tile per item. The Learn more link shows only when the item has a page.",
          "x-ui": {
            "sortable": true
          },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Tile heading, for example Trauma & PTSD."
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Sub text under the heading.",
                "x-ui": {
                  "widget": "textarea",
                  "rows": 3
                }
              },
              "page": {
                "$ref": "#/$defs/reference",
                "description": "The page the Learn more link opens, for example collection pages and id our-approach, or collection specialties and id emdr."
              }
            }
          }
        },
        "tileLinkLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Learn More"
        }
      }
    },
    "clinicians": {
      "type": "object",
      "title": "Clinicians",
      "additionalProperties": false,
      "x-cms": {
        "zone": "clinicians",
        "order": 1
      },
      "required": [
        "hidden",
        "eyebrow",
        "heading",
        "mode",
        "limit",
        "cardCtaLabel",
        "recruitingCard"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Our clinicians"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "default": "Choose your clinician, then your time."
        },
        "intro": {
          "type": "string",
          "maxLength": 200,
          "x-ui": {
            "widget": "textarea",
            "rows": 2
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto",
          "description": "auto shows every published clinician accepting new clients, in their sort order. manual shows the list below."
        },
        "clinicians": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/reference"
          },
          "x-ui": {
            "widget": "referenceList",
            "collection": "clinicians",
            "sortable": true
          },
          "description": "Used only when mode is manual."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "default": 6
        },
        "cardCtaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "View profile & times",
          "description": "Card button always opens the clinician's profile. Next open date is fetched live."
        },
        "recruitingCard": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hidden",
            "heading",
            "body",
            "link"
          ],
          "description": "Card shown beside the clinicians while the team is growing.",
          "properties": {
            "hidden": {
              "type": "boolean",
              "default": false
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "default": "Our team is growing."
            },
            "body": {
              "type": "string",
              "maxLength": 200,
              "x-ui": {
                "widget": "textarea",
                "rows": 2
              }
            },
            "link": {
              "$ref": "#/$defs/link",
              "default": {
                "label": "Careers",
                "target": {
                  "internal": {
                    "collection": "pages",
                    "id": "careers"
                  }
                }
              }
            }
          }
        }
      }
    },
    "howItWorks": {
      "type": "object",
      "title": "How it works",
      "additionalProperties": false,
      "x-cms": {
        "zone": "howItWorks",
        "order": 1
      },
      "required": [
        "hidden",
        "eyebrow",
        "heading",
        "steps",
        "moreLink"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "How it works"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "default": "Three steps to begin"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/titledText"
          },
          "description": "Numbered automatically (01, 02, …)."
        },
        "moreLink": {
          "$ref": "#/$defs/link",
          "default": {
            "label": "What to expect, in detail",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "what-to-expect"
              }
            }
          }
        }
      }
    },
    "approachBand": {
      "type": "object",
      "title": "Approach statement band",
      "additionalProperties": false,
      "x-cms": {
        "zone": "approachBand",
        "order": 1
      },
      "required": [
        "hidden",
        "eyebrow",
        "statement",
        "cta"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Our approach"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "description": "Large italic statement on the dark band. Not a client testimonial.",
          "x-ui": {
            "widget": "textarea",
            "rows": 3
          }
        },
        "cta": {
          "$ref": "#/$defs/link",
          "default": {
            "label": "Read our approach",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "our-approach"
              }
            }
          }
        }
      }
    },
    "seo": {
      "type": "object",
      "title": "SEO",
      "additionalProperties": false,
      "x-cms": {
        "zone": "meta",
        "order": 1
      },
      "required": [
        "title",
        "description",
        "noindex"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "ogImage": {
          "$ref": "#/$defs/image"
        },
        "noindex": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "id"
      ],
      "properties": {
        "collection": {
          "type": "string",
          "enum": [
            "pages",
            "clinicians",
            "specialties",
            "mediaAppearances",
            "blogPosts"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "internal"
              ],
              "properties": {
                "internal": {
                  "$ref": "#/$defs/reference"
                },
                "anchor": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "alt"
      ],
      "x-ui": {
        "widget": "image"
      },
      "properties": {
        "assetId": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "description": "Required for WCAG."
        },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "titledText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-ui": {
            "widget": "textarea",
            "rows": 2
          }
        }
      }
    }
  },
  "examples": [
    {
      "hero": {
        "eyebrow": "Trauma-informed psychotherapy · Long Island, New York",
        "heading": "A space to heal. The support to grow. The freedom to thrive.",
        "body": "At [Practice name], we believe exceptional mental health care begins with feeling truly seen, heard, and understood. Through personalized evidence-based psychotherapy, we offer a thoughtful and compassionate approach to healing from trauma, rebuilding a sense of safety, and reclaiming the confidence and freedom to move forward in Long Island and online across New York.",
        "primaryCta": {
          "label": "Meet our clinicians",
          "target": {
            "internal": {
              "collection": "pages",
              "id": "clinicians"
            }
          }
        },
        "secondaryLink": {
          "label": "What to expect",
          "target": {
            "internal": {
              "collection": "pages",
              "id": "what-to-expect"
            }
          }
        },
        "trustLine": [
          "Free 15-minute consultation",
          "Licensed clinicians",
          "[Insurance accepted]"
        ],
        "image": {
          "assetId": "[asset-id]",
          "alt": "Sunlit consulting room with a linen armchair and a plant"
        }
      },
      "featuredIn": {
        "hidden": false,
        "label": "Featured in",
        "appearances": [
          {
            "collection": "mediaAppearances",
            "id": "womlead-self-worth"
          },
          {
            "collection": "mediaAppearances",
            "id": "female-founders-ep-77"
          },
          {
            "collection": "mediaAppearances",
            "id": "youtube-interview"
          }
        ],
        "allLink": {
          "label": "All podcasts & press",
          "target": {
            "internal": {
              "collection": "pages",
              "id": "featured-in"
            }
          }
        }
      },
      "specialties": {
        "hidden": false,
        "eyebrow": "Specialties",
        "heading": "What we treat",
        "items": [
          {
            "collection": "specialties",
            "id": "trauma-ptsd"
          },
          {
            "collection": "specialties",
            "id": "emdr"
          },
          {
            "collection": "specialties",
            "id": "anxiety"
          },
          {
            "collection": "specialties",
            "id": "relationships"
          },
          {
            "collection": "specialties",
            "id": "grief-loss"
          },
          {
            "collection": "specialties",
            "id": "life-transitions"
          }
        ],
        "tileLinkLabel": "Learn more"
      },
      "clinicians": {
        "hidden": false,
        "eyebrow": "Our clinicians",
        "heading": "Choose your clinician, then your time.",
        "intro": "Every profile lists specialties, fees and open appointments.",
        "mode": "auto",
        "limit": 6,
        "cardCtaLabel": "View profile & times",
        "recruitingCard": {
          "hidden": false,
          "heading": "Our team is growing.",
          "body": "We are adding licensed clinicians in [Year]. Their profiles will appear here as they join.",
          "link": {
            "label": "Careers",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "careers"
              }
            }
          }
        }
      },
      "howItWorks": {
        "hidden": false,
        "eyebrow": "How it works",
        "heading": "Three steps to begin",
        "steps": [
          {
            "title": "Consultation",
            "body": "A free 15-minute call to see if we are the right fit."
          },
          {
            "title": "Assessment",
            "body": "A first session to understand your history and set goals."
          },
          {
            "title": "The work",
            "body": "Regular sessions, with progress reviewed together."
          }
        ],
        "moreLink": {
          "label": "What to expect, in detail",
          "target": {
            "internal": {
              "collection": "pages",
              "id": "what-to-expect"
            }
          }
        }
      },
      "approachBand": {
        "hidden": false,
        "eyebrow": "Our approach",
        "statement": "Good therapy is careful work: a clear assessment, a plan you understand, and a clinician who stays steady with you.",
        "cta": {
          "label": "Read our approach",
          "target": {
            "internal": {
              "collection": "pages",
              "id": "our-approach"
            }
          }
        }
      },
      "seo": {
        "title": "Trauma-Informed Psychotherapy · Long Island, NY",
        "description": "Evidence-based therapy for trauma, anxiety and relationships, in person on Long Island and online across New York. Free 15-minute consultation.",
        "noindex": false
      }
    }
  ]
}
