{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Share Your Experience",
  "description": "Copy for the private review form for current and past clients. Submissions go to the practice and are never published automatically. Header, footer and crisis line come from site settings.",
  "type": "object",
  "additionalProperties": false,
  "x-cms": {
    "kind": "singleton",
    "route": "/reviews/share",
    "template": "ShareExperiencePage",
    "zones": [
      "form",
      "notePanel",
      "thankYou",
      "meta"
    ]
  },
  "required": [
    "form",
    "notePanel",
    "thankYou",
    "seo"
  ],
  "properties": {
    "form": {
      "type": "object",
      "title": "Review form",
      "additionalProperties": false,
      "x-cms": {
        "zone": "form",
        "order": 1
      },
      "required": [
        "eyebrow",
        "heading",
        "labels",
        "errors",
        "submitLabel",
        "cancelLabel"
      ],
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "default": "For current and past clients"
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "default": "Share your experience",
          "description": "The page's only H1."
        },
        "intro": {
          "type": "string",
          "maxLength": 200,
          "default": "We read every response and use it to improve our care. It takes about three minutes."
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "email",
            "phone",
            "ratingLegend",
            "ratingOptions",
            "likedBest",
            "improve",
            "recommendLegend",
            "recommendOptions",
            "anythingElse",
            "publishConsent",
            "requiredMark"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "default": "Full name"
            },
            "email": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "default": "Email"
            },
            "phone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "default": "Phone"
            },
            "requiredMark": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20,
              "default": "(required)"
            },
            "ratingLegend": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "default": "Rate our services"
            },
            "ratingOptions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "excellent",
                "good",
                "disappointing"
              ],
              "properties": {
                "excellent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "default": "Excellent"
                },
                "good": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "default": "Good"
                },
                "disappointing": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "default": "Disappointing"
                }
              }
            },
            "likedBest": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "default": "What did you like best?"
            },
            "improve": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "default": "How can we improve?"
            },
            "recommendLegend": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "default": "Would you recommend us to your friends?"
            },
            "recommendOptions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "yes",
                "no"
              ],
              "properties": {
                "yes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "default": "Yes"
                },
                "no": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20,
                  "default": "No"
                }
              }
            },
            "anythingElse": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "default": "Anything else you would like to add?"
            },
            "publishConsent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "default": "You may share my review on your website, using my first name and last initial.",
              "description": "Optional checkbox. When ticked, the submission is flagged as publishable; staff still decide."
            }
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "name",
            "email"
          ],
          "description": "Shown as text under each field, starting with Error:.",
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "default": "Please fix {count} to continue."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "default": "Error: enter your full name."
            },
            "email": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "default": "Error: enter an email address like name@example.com."
            }
          }
        },
        "submitLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "Send review"
        },
        "cancelLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "default": "Cancel",
          "description": "Returns to the reviews page."
        }
      }
    },
    "notePanel": {
      "type": "object",
      "title": "Before you write panel",
      "additionalProperties": false,
      "x-cms": {
        "zone": "notePanel",
        "order": 1
      },
      "required": [
        "hidden",
        "heading",
        "items",
        "crisisText"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "default": "Before you write"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "crisisText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "default": "In crisis? Call or text 988, or call 911.",
          "description": "988 and 911 render as tel: links."
        }
      }
    },
    "thankYou": {
      "type": "object",
      "title": "Thank-you state",
      "additionalProperties": false,
      "x-cms": {
        "zone": "thankYou",
        "order": 1
      },
      "required": [
        "hidden",
        "heading",
        "body",
        "primaryLink"
      ],
      "properties": {
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "heading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "default": "Thank you for sharing.",
          "description": "Becomes the H1 after a successful submit."
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "default": "Your review has been sent to our team. We read every response."
        },
        "primaryLink": {
          "$ref": "#/$defs/link",
          "default": {
            "label": "Back to reviews",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "reviews"
              }
            }
          }
        },
        "secondaryLink": {
          "$ref": "#/$defs/link",
          "default": {
            "label": "Return to home",
            "target": {
              "internal": {
                "collection": "pages",
                "id": "home"
              }
            }
          }
        }
      },
      "description": "Required. Keep hidden false."
    },
    "seo": {
      "type": "object",
      "title": "SEO",
      "additionalProperties": false,
      "x-cms": {
        "zone": "meta",
        "order": 1
      },
      "required": [
        "title",
        "description",
        "noindex"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "ogImage": {
          "$ref": "#/$defs/image"
        },
        "noindex": {
          "type": "boolean",
          "default": false
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "id"
      ],
      "properties": {
        "collection": {
          "type": "string",
          "enum": [
            "pages",
            "clinicians",
            "specialties",
            "mediaAppearances",
            "blogPosts"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "internal"
              ],
              "properties": {
                "internal": {
                  "$ref": "#/$defs/reference"
                },
                "anchor": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "alt"
      ],
      "x-ui": {
        "widget": "image"
      },
      "properties": {
        "assetId": {
          "type": "string"
        },
        "alt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "description": "Required for WCAG."
        },
        "focalPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    }
  }
}
