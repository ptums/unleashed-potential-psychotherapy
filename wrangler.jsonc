{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unleashed-potential-psychotherapy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "unleashed-potential-psychotherapy"
    }
  ],
  // /api/submit: 3 submissions per IP per minute (ported from jessrebelo.com, which uses 1001).
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  },
  // Worker custom domains. Cloudflare creates the DNS records and certificates for these.
  // cms.uptherapygroup.com is a separate DNS-only record (AWS CloudFront) and is not touched.
  "routes": [
    { "pattern": "uptherapygroup.com", "custom_domain": true },
    { "pattern": "www.uptherapygroup.com", "custom_domain": true }
  ]
}
